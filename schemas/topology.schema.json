{
  "$id": "https://harnessy.dev/schemas/topology.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^top-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
    },
    "name": {
      "type": "string"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^end-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
              },
              "kind": {
                "type": "string",
                "const": "connector"
              },
              "connector": {
                "type": "string",
                "pattern": "^cmp-[23456789abcdefghjkmnpqrstuvwxyz]{6}\\/[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "id",
              "kind",
              "connector"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^end-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
              },
              "kind": {
                "type": "string",
                "const": "point"
              }
            },
            "required": [
              "id",
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^end-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
              },
              "kind": {
                "type": "string",
                "const": "breakout"
              },
              "spec": {
                "type": "string",
                "pattern": "^(breakouts)\\/[a-z0-9][a-z0-9-]*$"
              }
            },
            "required": [
              "id",
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^end-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
              },
              "kind": {
                "type": "string",
                "const": "splice"
              },
              "nets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^net-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
                }
              },
              "spec": {
                "type": "string",
                "pattern": "^(splices)\\/[a-z0-9][a-z0-9-]*$"
              }
            },
            "required": [
              "id",
              "kind",
              "nets"
            ]
          }
        ]
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^seg-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
          },
          "ends": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^end-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
              },
              {
                "type": "string",
                "pattern": "^end-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "length_mm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "assembly": {
            "type": "string",
            "pattern": "^(assemblies)\\/[a-z0-9][a-z0-9-]*$"
          },
          "harness": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "part_number": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "id",
          "ends"
        ]
      }
    },
    "sheaths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sht-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
          },
          "spec": {
            "type": "string",
            "pattern": "^(sheaths)\\/[a-z0-9][a-z0-9-]*$"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^seg-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
            }
          },
          "overlap_mm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "spec",
          "segments",
          "overlap_mm"
        ]
      }
    },
    "ties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tie-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
          },
          "segment": {
            "type": "string",
            "pattern": "^seg-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
          },
          "from": {
            "type": "string",
            "pattern": "^end-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
          },
          "distance_mm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "spec": {
            "type": "string",
            "pattern": "^(ties)\\/[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": [
          "id",
          "segment",
          "from",
          "distance_mm",
          "spec"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "endpoints",
    "segments",
    "sheaths",
    "ties"
  ]
}
