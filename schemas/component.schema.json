{
  "$id": "https://harnessy.dev/schemas/component.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cmp-[23456789abcdefghjkmnpqrstuvwxyz]{6}$"
    },
    "name": {
      "type": "string"
    },
    "definition": {
      "type": "string",
      "pattern": "^(components)\\/[a-z0-9][a-z0-9-]*$"
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "designator": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "connector": {
            "type": "string",
            "pattern": "^(connectors)\\/[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          }
        },
        "required": [
          "designator",
          "connector"
        ]
      }
    }
  },
  "required": [
    "id",
    "name"
  ]
}
