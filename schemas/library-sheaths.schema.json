{
  "$id": "https://harnessy.dev/schemas/library-sheaths.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "braid",
        "spiral",
        "heatshrink"
      ]
    },
    "id_mm": {
      "type": "number",
      "minimum": 0
    },
    "part_number": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "id_mm"
  ]
}
