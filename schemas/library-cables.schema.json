{
  "$id": "https://harnessy.dev/schemas/library-cables.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "conductors": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "awg": {
      "type": "number"
    },
    "od_mm": {
      "type": "number",
      "minimum": 0
    },
    "shielded": {
      "type": "boolean"
    },
    "part_number": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "conductors",
    "awg",
    "od_mm",
    "shielded"
  ]
}
