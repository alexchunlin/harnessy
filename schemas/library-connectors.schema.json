{
  "$id": "https://harnessy.dev/schemas/library-connectors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "pins": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mating": {
      "type": "object",
      "properties": {
        "part_number": {
          "type": "string"
        },
        "contacts_part_number": {
          "type": "string"
        }
      },
      "required": [
        "part_number"
      ]
    },
    "manufacturer": {
      "type": "string"
    },
    "datasheet": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "pins",
    "mating"
  ]
}
