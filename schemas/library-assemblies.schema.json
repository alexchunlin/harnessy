{
  "$id": "https://harnessy.dev/schemas/library-assemblies.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "length_mm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ends": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^(connectors)\\/[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "string",
          "pattern": "^(connectors)\\/[a-z0-9][a-z0-9-]*$"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "cable": {
      "type": "string",
      "pattern": "^(cables)\\/[a-z0-9][a-z0-9-]*$"
    }
  },
  "required": [
    "id",
    "name",
    "part_number",
    "length_mm",
    "ends"
  ]
}
