{
  "$id": "https://harnessy.dev/schemas/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "spec": {
            "type": "string",
            "pattern": "^(wires|cables)\\/[a-z0-9][a-z0-9-]*$"
          },
          "conductors": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "conductors"
        ]
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "required": [
          "id",
          "name",
          "domains"
        ]
      }
    },
    "keep_apart": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "required": [
    "schema",
    "name",
    "domains",
    "layers"
  ]
}
